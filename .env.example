# ── Cloudflare Worker URL ─────────────────────────────────────────────────
# Local dev: http://localhost:8787  (run `npx wrangler dev` in the worker/ folder)
# Production: https://media-platform-api.<your-subdomain>.workers.dev
VITE_WORKER_URL=http://localhost:8787

# ── Worker Secrets (set via `npx wrangler secret put` or .dev.vars) ───────
# These are NEVER exposed to the browser. Set only on the Worker side.

# Found in: Cloudflare Dashboard → Account ID (right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Create at: Cloudflare Dashboard → My Profile → API Tokens
# Required permissions: Cloudflare Stream → Edit
CLOUDFLARE_API_TOKEN=

# Create at: Cloudflare Dashboard → Stream → Signing Keys → Create
# Paste the "Key ID" value shown in the dashboard
CLOUDFLARE_STREAM_KEY_ID=

# From the same page, download / copy the PEM private key (PKCS#8 format)
# It starts with -----BEGIN PRIVATE KEY-----
# Replace actual newlines with \n for a single-line env var, e.g.:
# CLOUDFLARE_STREAM_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
CLOUDFLARE_STREAM_SIGNING_KEY=
