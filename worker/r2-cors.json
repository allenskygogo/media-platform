{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://toplevel-tw.com",
          "https://www.toplevel-tw.com",
          "https://media-platform-orcin.vercel.app"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
